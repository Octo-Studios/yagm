{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/yagm",
    "sources": "https://github.com/Octo-Studios/yagm",
    "issues": "https://github.com/Octo-Studios/yagm/issues"
  },
  "license": "All Rights Reserved",
  "environment": "*",
  "entrypoints": {
    "main": [
      "it.hurts.sskirillss.yagm.fabric.YAGMFabric"
    ],
    "client": [
      "it.hurts.sskirillss.yagm.fabric.client.YAGMFabricClient"
    ]
  },
  "mixins": [
    "yagm.mixins.json",
    "yagm-common.mixins.json"
  ],
  "depends": {
    "fabric": "*",
    "architectury": ">=${architectury_version}",
    "octolib": ">=0.6.2",
    "minecraft": "${minecraft_version}"
  },
  "suggests": {
    "trinkets": "*",
    "accessories": "*"
  }
}
